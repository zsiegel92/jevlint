{
  "exclude": [
    "node_modules/**", "dist/**", "build/**", "coverage/**", ".next/**",
    ".jevlint/**", "**/*.d.ts", "**/*.generated.ts"
  ],
  "rules_dir": ".jevlint-rules",
  "system_prompt": ".jevlint-system.md",
  "cache_dir": ".jevlint",
  "model": "jev-latest",
  "concurrency": 5,
  "request_timeout_seconds": 30,
  "typesafe_api_key_file": "~/.config/jevlint/typesafe-api-key",
  "rule_sets": [
    {
      "match": ["*.ts", "*.tsx", "**/*.ts", "**/*.tsx"],
      "error": { "no-floating-promises": 0.8 },
      "warn": { "no-unvalidated-boundary-cast": 0.8 }
    }
  ],
  "line_detection": { "enabled": true, "max_questions_per_request": 200 },
  "watch": { "debounce_milliseconds": 300 },
  "precondition": {
    "command": ["sh", "-c", "pnpm exec tsc --noEmit --pretty false && pnpm exec biome check ."]
  }
}
